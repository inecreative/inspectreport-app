# --- Required in production (Render sets most of these via render.yaml) ---

# PostgreSQL connection string. On Render this comes from the linked database.
# Locally, leave unset to run against an in-memory throwaway DB (data is lost on restart),
# or set it to your own Postgres, e.g. postgres://user:pass@localhost:5432/inspectreport
DATABASE_URL=

# Long random string used to sign/protect sessions. Render generates this for you.
SESSION_SECRET=change-me-to-a-long-random-string

# Directory where uploaded photos are stored. On Render this is the persistent disk mount.
UPLOAD_DIR=./uploads

# --- Optional ---

# Port the server listens on (Render sets PORT automatically).
PORT=3000

# AI structuring features. If AI_API_KEY is empty, the app uses a built-in
# keyword-based structurer instead, so everything still works.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Stripe Payment Link URL for the $49/mo plan (created in the Stripe dashboard).
# If empty, the Subscribe button in the app is disabled.
PAYMENT_LINK_URL=
